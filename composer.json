{
    "name": "magenable/module-category-facet-robots-manager",
    "description": "This Magento 2 module provides the ability to add a noindex meta tag to category pages with filters",
    "require": {
        "magento/framework": ">=102.0",
        "magenable/module-base": "*"
    },
    "type": "magento2-module",
    "version": "1.0.2",
    "license": "MIT",
    "authors": [
        {
            "name": "Magenable",
            "homepage": "https://magenable.com.au"
        }
    ],
    "keywords": [
        "magento 2 category facet robots manager",
        "category facet robots manager",
        "category filter robots manager"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magenable\\CategoryFacetRobotsManager\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
